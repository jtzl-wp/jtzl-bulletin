{
	"name": "jtzl-bulletin-assets",
	"version": "0.6.4",
	"description": "JTZL's Bulletin for bbPress plugin assets - reading-view build system",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run typecheck && bun run build:js && bun run build:css && bun run verify:build",
		"build:js": "NODE_ENV=production bun run esbuild.config.js",
		"build:css": "postcss src/styles/bulletin.css -o build/jtzl-bltn.css && bun run scripts/hash-assets.js",
		"build:prod": "bun run build",
		"verify:build": "bun run scripts/verify-build.js",
		"typecheck": "tsc --noEmit",
		"dev": "NODE_ENV=development bun run esbuild.config.js",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"lint": "eslint src tests scripts --ext .js,.ts,.tsx",
		"lint:fix": "eslint src tests scripts --ext .js,.ts,.tsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit": "bun audit",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@wordpress/prettier-config": "^4.4.0",
		"autoprefixer": "^10.4.20",
		"cssnano": "^7.0.6",
		"esbuild": "^0.25.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.31.0",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"lint-staged": "^15.2.11",
		"postcss": "^8.4.49",
		"postcss-cli": "^11.0.0",
		"postcss-import": "^16.1.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.2",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"minimatch": ">=3.1.3",
		"brace-expansion": ">=5.0.9",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4",
		"esbuild": ">=0.25.0",
		"postcss": ">=8.5.23",
		"nanoid": ">=3.3.18 <4",
		"js-yaml": ">=4.3.1 <5"
	},
	"engines": {
		"node": ">=20",
		"bun": ">=1.0.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"*.{css,json,md}": [
			"prettier --write"
		],
		"*.php": [
			"vendor/bin/phpcbf --standard=phpcs.xml.dist --report=summary --"
		]
	}
}
